# Soulbyte — servidor del sitio en Railway (Railpack usa este archivo en lugar del suyo).
# Parte de la plantilla oficial de Railpack (core/providers/staticfile/Caddyfile.template) y agrega:
# www.soulbyte.app → soulbyte.app con 301, archivos internos ocultos y caché por tipo de archivo.
# Railpack procesa este archivo como plantilla: {{.StaticFileRoot}} es la carpeta que se sirve.
{
	admin off
	persist_config off
	auto_https off

	log {
		format json
	}

	servers {
		trusted_proxies static private_ranges
	}
}

:{$PORT:80} {
	log {
		format json
	}

	respond /health 200

	# Un solo dominio para Google: www redirige a la raíz conservando la ruta
	@www host www.soulbyte.app
	redir @www https://soulbyte.app{uri} permanent

	header {
		X-XSS-Protection "1; mode=block"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Content-Security-Policy "default-src 'self'; img-src 'self' data: https: *; style-src 'self' 'unsafe-inline' https: *; script-src 'self' 'unsafe-inline' https: *; font-src 'self' data: https: *; connect-src 'self' https: *; media-src 'self' https: *; object-src 'none'; frame-src 'self' https: *;"
		-Server
	}

	# Caché: imágenes e íconos 30 días; CSS, JS y páginas siempre revalidan (ETag: 304 si no cambiaron)
	@imagenes path *.png *.jpg *.jpeg *.svg *.ico *.webp
	header @imagenes Cache-Control "public, max-age=2592000"
	@estilos path *.css *.js
	header @estilos Cache-Control "no-cache"
	@paginas path / */ *.html
	header @paginas Cache-Control "no-cache"

	# Vista previa de los enlaces en WhatsApp: su cliente pide cada enlace con Range y
	# Accept-Encoding: gzip. Con los dos, Caddy respondía 206 comprimido con un Content-Range
	# del archivo sin comprimir (respuesta inválida) y WhatsApp armaba la tarjeta sin título,
	# descripción ni imagen. Todo lo que se comprime ignora Range y responde 200, como
	# hitaircolombia.com y ekivibes.com; las imágenes, que no se comprimen, conservan el 206.
	@sin_rango not path *.png *.jpg *.jpeg *.webp *.gif
	request_header @sin_rango -Range

	root * {{.StaticFileRoot}}

	file_server {
		hide .git .env* Caddyfile Caddyfile.template Staticfile README.md .nojekyll
	}

	encode {
		gzip
		zstd
	}

	try_files {path} {path}.html {path}/index.html

	handle_errors {
		rewrite * /{err.status_code}.html
		file_server
	}
}
